# Copy to .env.local and fill in. Every value is optional: with none set, Plumbline runs
# with a local JSON database and the AI judgement pass switched off.

# Google Gemini (free key from https://aistudio.google.com/apikey). Enables the tone and
# messaging pass, alt-text drafting and guideline import.
GEMINI_API_KEY=
# Optional override. Defaults to gemini-3.1-flash-lite, then gemini-3.5-flash-lite, then gemini-flash-latest.
GEMINI_MODEL=

# Supabase (Project settings → API). Server-only: never expose the service-role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Signs the demo sign-in cookie. Required on a hosted server. Any long random text.
# (There is no Admin code: it was removed so judges can open every role, Admin included.)
SESSION_SECRET=
